# Docker Compose environment template for Linux/Ubuntu.
#
# Copy this file to `.env` before running:
#   cp .env.docker.example .env
#
# The docker-compose.yml file already overrides the local-development
# "localhost" defaults for Postgres/Redis/Milvus/Temporal/Langfuse with Docker
# service names. This file is only for values that are specific to your
# deployment: secrets, the cloud LLM endpoint, and the local Ollama model names.
#
# IMPORTANT: `.env` is gitignored. Never commit real secrets.

# --- Application ---
LEGAL_AI_ENV=production
LEGAL_AI_SECRET_KEY=change-me-in-production
LEGAL_AI_DATA_DIR=/app/data

# --- LLM: Ollama cloud (or any other Ollama-compatible remote endpoint) ---
LEGAL_AI_LLM_PROVIDER=ollama
# LLM model name WITHOUT the LiteLLM provider prefix (the app adds "ollama/").
LEGAL_AI_LLM_MODEL=llama3.1:8b
# Base URL of your cloud/private Ollama instance (no /v1 suffix).
LEGAL_AI_LLM_API_BASE=https://your-ollama-cloud.example.com
# Add an API key here only if your Ollama endpoint requires one.
LEGAL_AI_LLM_API_KEY=
LEGAL_AI_LLM_TEMPERATURE=0.1

# --- Embeddings: Ollama running on the Docker host ---
# docker-compose.yml sets LEGAL_AI_EMBEDDING_API_BASE=http://host.docker.internal:11434
# for the api/celery services. The model name MUST include the LiteLLM provider
# prefix. Pull the embedding model on the host first:
#   ollama pull nomic-embed-text
LEGAL_AI_EMBEDDING_MODEL=ollama/nomic-embed-text
LEGAL_AI_EMBEDDING_DIMENSION=768
LEGAL_AI_EMBEDDING_API_KEY=

# --- Postgres (shared by API, Temporal and Langfuse) ---
POSTGRES_USER=legal
POSTGRES_PASSWORD=legal
POSTGRES_DB=legal_ai

# --- Minio (used by Milvus) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Observability ---
#LEGAL_AI_OTEL_ENABLED=false
#LEGAL_AI_OTEL_ENDPOINT=http://localhost:4318

# Langfuse is started with `docker compose --profile observability up -d`.
# The compose file already points the app to http://langfuse:3000 internally.
LEGAL_AI_LANGFUSE_PUBLIC_KEY=
LEGAL_AI_LANGFUSE_SECRET_KEY=
#LEGAL_AI_LANGFUSE_HOST=http://localhost:3002

# --- Langfuse UI secrets (used by the langfuse service) ---
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production

# --- Tuning (optional; defaults in backend/core/config.py) ---
#LEGAL_AI_DEFAULT_TOP_K=8
#LEGAL_AI_RETRIEVAL_FETCH_K=20
#LEGAL_AI_CONTEXT_MAX_TURNS=10
