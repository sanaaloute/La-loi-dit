{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yawoto-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Runtime proxy target for the /backend-api route handlers (chat SSE and
    // search). The generic rewrite destination is baked at BUILD time from
    // the same variable — set API_PROXY_TARGET in the shell when running
    // `npm run build:cloudflare` (see package.json).
    "API_PROXY_TARGET": "https://api.yawoto.neobytech.net"
  }
}
