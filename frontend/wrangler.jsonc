{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yawoto-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain: takes over the DNS record that used to point at the old
  // Mac-side "yawoto" tunnel. Cloudflare replaces the tunnel CNAME when the
  // workers domain is created (the tunnel route can then be deleted).
  "routes": [{ "pattern": "yawoto.neobytech.net", "custom_domain": true }],
  "vars": {
    // Runtime proxy target for the /backend-api route handlers (chat SSE and
    // search). The generic rewrite destination is baked at BUILD time from
    // the same variable — the npm cloudflare scripts default it to this
    // value (see package.json); a Cloudflare build without it proxies
    // /backend-api to localhost and every API call fails with a CF 1003.
    "API_PROXY_TARGET": "https://api-yawoto.neobytech.net"
  }
}
