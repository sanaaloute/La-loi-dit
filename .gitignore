__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Keep the data/ directory tracked so the server bind-mount exists after clone.
# Compulsory configuration files are tracked; generated indexes/state and
# uploaded source documents are ignored.

# Generated runtime state and indexes.
data/*.db
data/*.db.*
data/*.bak
data/*.bak*
data/ingestion_results.json
data/versions.json
data/freshness_state.json
data/tmp/
data/eval/**

# Uploaded source documents (re-ingest after deploy; do not commit).
data/legal_docs/**

# Track the directory skeleton and compulsory configuration files.
!data/.gitkeep
!data/legal_docs/.gitkeep
!data/legal_sources.json
!data/legal_domains.json
!data/terminology.json
!data/decomposition.json

htmlcov/
node_modules/
dist/
build/
*.log
.volumes/

# Locally downloaded build wheels (see scripts/download_wheels.sh).
# Keep the directory tracked so COPY doesn't fail, but never commit .whl files.
docker/wheels/*
!docker/wheels/.gitkeep

# Windows reserved device name — never commit a stray file named "nul"
nul

# Root dotfiles are local tooling/environment — not tracked, except the
# functional ones negated below (anchored to the repo root so nested
# dotfiles like frontend/.gitignore are unaffected).
/.*
!.gitattributes
!.gitignore
!.dockerignore
!.env.example
!.env.dev.example
!.github/
!.vscode/
!.kimi/

# Local test / benchmark artifacts at the repo root
/=*
/*.png
/*.pdf
/test.md
/*_tmp.py
/embed_benchmark*.txt
tests