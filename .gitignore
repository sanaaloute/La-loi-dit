__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Keep the data/ directory tracked so the server bind-mount exists after clone,
# but ignore everything inside it. Source documents are uploaded through the
# admin UI; generated DBs/indexes are never committed.
data/**
!data/.gitkeep

htmlcov/
node_modules/
dist/
build/
*.log
.volumes/

# Locally downloaded build wheels (see scripts/download_wheels.sh).
# Keep the directory tracked so COPY doesn't fail, but never commit .whl files.
docker/wheels/*
!docker/wheels/.gitkeep

# Windows reserved device name — never commit a stray file named "nul"
nul

# Root dotfiles are local tooling/environment — not tracked, except the
# functional ones negated below (anchored to the repo root so nested
# dotfiles like frontend/.gitignore are unaffected).
/.*
!.gitignore
!.dockerignore
!.env.example
!.env.dev.example
!.github/
!.vscode/
!.kimi/

# Local test / benchmark artifacts at the repo root
/=*
/*.png
/*.pdf
/test.md
/*_tmp.py
/embed_benchmark*.txt
tests