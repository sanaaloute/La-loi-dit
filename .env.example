# =============================================================================
# Yawoto — Production / Docker Compose environment template
# =============================================================================
# Copy to `.env` and fill in real values before running:
#   cp .env.example .env
#
# This file serves TWO consumers:
#   1. docker-compose.yml — variable interpolation (${POSTGRES_USER}, ...) and
#      `env_file: .env` for the api / celery-worker services. Compose holds NO
#      configuration values of its own: `.env` is the ONLY source of truth.
#      (Single exception: DATABASE_URL is assembled in compose from the
#      POSTGRES_* credentials below, so the password lives in one place.)
#   2. The backend Settings (backend/core/config.py) — every app setting uses
#      the LEGAL_AI_ prefix. Sane defaults exist for everything; only the
#      variables marked [REQUIRED] must be set for production.
#
# Conventions in this file:
#   - ACTIVE lines are what a production deploy must set (or compose needs).
#   - COMMENTED lines (#LEGAL_AI_...) are optional tunables; the value shown
#     is the built-in default from backend/core/config.py. Uncomment to change.
#
# IMPORTANT: `.env` is gitignored. Never commit real secrets.
# =============================================================================

# --- Core ----------------------------------------------------------------------
# [REQUIRED] production enables strict infra mode: no silent fallbacks,
# /ready returns 503 when Milvus/Postgres are down or disabled.
LEGAL_AI_ENV=production
# [REQUIRED] JWT signing key. Generate with: openssl rand -hex 32
LEGAL_AI_SECRET_KEY=change-me-in-production
LEGAL_AI_APP_NAME="Yawoto — Assistant Juridique"
# Version string reported by the API metadata (bump with releases).
#LEGAL_AI_APP_VERSION=0.1.0
LEGAL_AI_DATA_DIR=/app/data
LEGAL_AI_LOG_LEVEL=INFO
# Max entries kept in the in-memory audit log ring buffer.
#LEGAL_AI_AUDIT_LOG_CAP=1000
# Index data/legal_docs in the background at every boot. Idempotent
# (content-hash versioning) and lock-guarded against multi-worker double-runs.
#LEGAL_AI_INGEST_ON_STARTUP=false

# --- Scalability / high availability -------------------------------------------
# Uvicorn workers for the api service (compose default: 2).
# workers > 1 REQUIRES Redis + Postgres + Milvus (in-memory fallbacks are
# per-process). Strict mode (on in production) reports violations via /ready.
LEGAL_AI_WEB_WORKERS=2
# Override strict mode explicitly (default: on when ENV=production).
#LEGAL_AI_STRICT_INFRA=true
# Infra components whose "degraded" status makes /ready return 503 in strict
# mode. Validated at boot against: milvus, postgres, database_probe,
# vector_store_probe, cache_probe, redis, llm, embeddings, user_store,
# memory_store, legal_graph. cache/memory_store/legal_graph stay non-critical
# by default — their fallbacks are survivable per request.
#LEGAL_AI_STRICT_CRITICAL_COMPONENTS=milvus,postgres,database_probe,llm,embeddings,user_store

# --- Security ------------------------------------------------------------------
# JWT lifetime in minutes.
LEGAL_AI_JWT_EXPIRE_MINUTES=60
#LEGAL_AI_JWT_ALGORITHM=HS256
# Anonymous/IP rate limit per minute (tier limits live in the catalog:
# gratuit 30 / pro 120 / cabinet 600). The config default is 10000
# (effectively unlimited); 30 is the recommended production value.
LEGAL_AI_RATE_LIMIT_PER_MINUTE=30
# Per-user/IP per-second burst cap.
#LEGAL_AI_RATE_LIMIT_PER_SECOND=5
# Enforce a single active session per user (invalidate previous tokens on new login).
#LEGAL_AI_SINGLE_SESSION_PER_USER=true
# Browser origins allowed to call the API directly (CORS). Needed only when
# the browser bypasses the Next.js /backend-api proxy (NEXT_PUBLIC_API_URL).
#LEGAL_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Bootstrap accounts, format: user:pass:role,user2:pass2:role2
# (role: admin | legal_expert | user | viewer). Dev-store users get the
# "cabinet" tier. In production, configure the ONE allowed admin account here.
# Only a single admin account is permitted; extra admin entries are ignored.
# Example: LEGAL_AI_DEV_USERS=admin:STRONG_PASSPHRASE:admin
LEGAL_AI_DEV_USERS=

# --- LLM providers ---------------------------------------------------------------
# Default/fallback provider used when a request has no tier-specific routing.
# ollama | openrouter | openai | anthropic | gemini | deepseek | qwen | kimi | mock
LEGAL_AI_LLM_PROVIDER=ollama
# Model name WITHOUT the LiteLLM prefix (the app adds it).
# For local Ollama via the relay, set this to a model you have pulled, e.g.
# qwen2.5:7b, llama3.2:3b, etc. The default gpt-oss:120b is only available on
# Ollama Cloud or other providers that serve it.
LEGAL_AI_LLM_MODEL=qwen2.5:7b
# API base for the default provider.
# - Local Ollama through the docker compose relay: http://172.18.0.1:11434
# - Ollama Cloud: https://ollama.com
# - OpenRouter: https://openrouter.ai/api/v1
LEGAL_AI_LLM_API_BASE=http://172.18.0.1:11434
# [REQUIRED with ollama cloud / openrouter] sent as Authorization: Bearer <key>.
# Leave empty for a local, unauthenticated Ollama instance.
LEGAL_AI_LLM_API_KEY=
LEGAL_AI_LLM_TEMPERATURE=0.1
LEGAL_AI_LLM_MAX_TOKENS=4096
LEGAL_AI_LLM_TIMEOUT_SECONDS=60

# [REQUIRED for Pro/Cabinet tiers] OpenRouter — https://openrouter.ai/keys
# Falls back to LEGAL_AI_LLM_API_KEY when empty.
LEGAL_AI_OPENROUTER_API_KEY=

# TokenFree (OpenAI-compatible API — https://www.tokenfree.com). The app
# targets https://www.tokenfree.com/v1/chat/completions by default (override
# with LEGAL_AI_LLM_API_BASE when tokenfree is the default provider).
LEGAL_AI_TOKENFREE_API_KEY=

# Providers tried (in order) when the primary LLM fails or returns an empty
# completion. Providers without a configured API key are skipped silently, so
# the chain is inert in key-less/offline setups.
#LEGAL_AI_LLM_FALLBACK_PROVIDERS=openrouter,tokenfree

# Optional: replace the whole built-in tier catalog (providers, models per
# tier, features, quotas, rate limits) with your own JSON.
# See backend/core/catalog.py for the expected shape.
#LEGAL_AI_TIER_CATALOG_JSON=

# --- Speech-to-text (voice input in the chat composer) ----------------------
# Voice notes (max 30 s) are transcribed, then shown in the input for review.
# Provider: "litellm" (cloud Whisper-compatible API) or "faster-whisper"
# (fully local, CPU). IMPORTANT: the default Ollama LLM setup CANNOT serve
# transcriptions — either set faster-whisper here, or point the litellm
# provider at a transcription-capable endpoint below.
#LEGAL_AI_STT_PROVIDER=faster-whisper
# litellm provider: any LiteLLM transcription model, e.g. "whisper-1"
# (OpenAI) or "groq/whisper-large-v3". By default it reuses
# LEGAL_AI_LLM_API_KEY / LEGAL_AI_LLM_API_BASE; override when the
# transcription endpoint differs from the chat LLM:
#LEGAL_AI_STT_MODEL=whisper-1
#LEGAL_AI_STT_API_KEY=
#LEGAL_AI_STT_API_BASE=
#LEGAL_AI_STT_LANGUAGE=fr
#LEGAL_AI_STT_TIMEOUT_SECONDS=90
# faster-whisper provider (local): tiny < base < small < medium (size/quality).
# Models download once into LEGAL_AI_STT_MODELS_DIR (default data/stt_models,
# a persistent compose volume — pre-download there for offline containers).
# Models come from HuggingFace; on networks where huggingface.co is blocked,
# set HF_ENDPOINT=https://hf-mirror.com and HF_HUB_DISABLE_XET=1 (the xet
# transfer backend bypasses the mirror) for the download.
#LEGAL_AI_FASTER_WHISPER_MODEL_SIZE=small
#HF_ENDPOINT=https://hf-mirror.com
#HF_HUB_DISABLE_XET=1
#LEGAL_AI_STT_MAX_AUDIO_BYTES=26214400

# --- Token optimization (answer cache / cheap routing) ---------------------------
# Cache final answers; identical questions skip the whole pipeline.
#LEGAL_AI_ANSWER_CACHE_ENABLED=true
# Cosine floor for near-duplicate (semantic) cache hits.
#LEGAL_AI_ANSWER_CACHE_SEMANTIC_THRESHOLD=0.98
# Semantic index size (most recent entries kept for similarity matching).
#LEGAL_AI_ANSWER_CACHE_MAX_INDEX=50
# Route simple queries to the tier's cheapest model.
#LEGAL_AI_CHEAP_ROUTING_ENABLED=true

# --- Model role routing ----------------------------------------------------------
# OFF by default (zero behavior change). When ON, each graph node's LLM calls
# go to the role's override model (same provider as the request's resolved
# model); roles without an override keep the request's model. Intended mapping:
# classification -> context/memory (cheap), planner -> planner (cheap),
# analysis -> reasoning/reflection, synthesis -> response_generator (strongest).
#LEGAL_AI_MODEL_ROLE_ROUTING_ENABLED=false
#LEGAL_AI_PLANNER_MODEL=
#LEGAL_AI_CLASSIFICATION_MODEL=
#LEGAL_AI_ANALYSIS_MODEL=
#LEGAL_AI_SYNTHESIS_MODEL=

# --- Embeddings ----------------------------------------------------------------
# Three supported setups — pick ONE by adjusting MODEL/BASE/KEY below:
#   a) OpenRouter embeddings (default below): model openrouter/<name> — e.g.
#      openrouter/nvidia/nemotron-3-embed-1b:free — base and key are derived
#      from LEGAL_AI_OPENROUTER_API_KEY automatically. NOTE: OpenRouter's
#      /models list does not advertise embedding models, but they are served.
#   b) Ollama Cloud: model ollama/<name>, base https://ollama.com, reuses
#      LEGAL_AI_LLM_API_KEY automatically. Requires an Ollama account whose
#      plan includes embedding models (chat-only accounts get 401 on
#      /api/embed even with a valid key).
#   c) Local Ollama: model ollama/<name>, base http://localhost:11434
#      (or http://host.docker.internal:11434 from containers), no key needed.
# IMPORTANT: the embedding DIMENSION must match the model
# (nvidia/nemotron-3-embed-1b = 2048, nomic-embed-text = 768 — check the model
# card). If you change the model on an existing database, re-ingest your
# documents: stored vectors are not comparable across models.
LEGAL_AI_EMBEDDING_MODEL=openrouter/nvidia/nemotron-3-embed-1b:free
LEGAL_AI_EMBEDDING_DIMENSION=2048
# Optional dedicated key/base — leave empty to reuse the provider keys above.
# For the default OpenRouter embedding model, leave this empty so the app
# uses https://openrouter.ai/api/v1 automatically. Set it explicitly only for
# Ollama local embeddings, e.g. http://172.18.0.1:11434.
LEGAL_AI_EMBEDDING_API_KEY=
LEGAL_AI_EMBEDDING_API_BASE=
# Texts per embedding API call (NVIDIA via OpenRouter caps at 256).
#LEGAL_AI_EMBEDDING_BATCH_SIZE=200

# --- Vector store (Milvus) -------------------------------------------------------
# [REQUIRED with docker-compose] Values use docker service names — change them
# only for deployments outside docker-compose. When disabled/unreachable the
# app falls back to an in-memory vector store (per-process, not for prod).
LEGAL_AI_MILVUS_ENABLED=true
LEGAL_AI_MILVUS_HOST=milvus
LEGAL_AI_MILVUS_PORT=19530
LEGAL_AI_MILVUS_COLLECTION=legal_chunks
# Optional dev fallback: run WITHOUT the Milvus server by pointing at a local
# Milvus Lite file (takes precedence over HOST/PORT). Local runs on the docker
# host should instead use LEGAL_AI_MILVUS_HOST=localhost (see .env.dev).
#LEGAL_AI_MILVUS_URI=./data/milvus_lite.db
# Cold WSL/docker handshakes exceed 3s; 15s avoids spurious fallbacks.
#LEGAL_AI_MILVUS_CONNECT_TIMEOUT_SECONDS=15
# Connection attempts before giving up and falling back to in-memory.
#LEGAL_AI_MILVUS_CONNECT_ATTEMPTS=3
# Backoff sleep multiplier (x attempt number) between connect attempts.
#LEGAL_AI_MILVUS_CONNECT_BACKOFF_SECONDS=1.0
# Fetch this many times top_k per filtered query so post-filtering still
# returns enough candidates.
#LEGAL_AI_MILVUS_FILTER_OVERFETCH=4

# --- Cache / Redis ---------------------------------------------------------------
# [REQUIRED with docker-compose] redis is the compose service name.
LEGAL_AI_REDIS_ENABLED=true
LEGAL_AI_REDIS_URL=redis://redis:6379/0
LEGAL_AI_CACHE_TTL_SECONDS=3600
# Short TTL so re-indexing becomes visible quickly.
#LEGAL_AI_RETRIEVAL_CACHE_TTL_SECONDS=300
# Key prefix for cached retrieval results (change to invalidate en masse).
#LEGAL_AI_RETRIEVAL_CACHE_NAMESPACE=retrieval:

# --- Database --------------------------------------------------------------------
# LEGAL_AI_DATABASE_URL is NOT set here: compose assembles it from the
# POSTGRES_* credentials below (single place for the password). Outside
# compose, set it directly, e.g.:
#   LEGAL_AI_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/legal_ai
# Local dev default (no Postgres): sqlite+aiosqlite:///./data/legal_ai.db

# --- Infrastructure credentials (consumed by docker-compose.yml) ---------------
# [REQUIRED] Postgres — shared by the app, Temporal and Langfuse.
POSTGRES_USER=legal
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=legal_ai
# Host port for the postgres service (change if 5432 is taken locally).
POSTGRES_HOST_PORT=5432

# [REQUIRED] MinIO (Milvus object storage).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# [REQUIRED] Grafana admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# --- Retrieval & ranking ---------------------------------------------------------
# Evidence chunks returned per query.
#LEGAL_AI_DEFAULT_TOP_K=8
# Candidates fetched per worker before fusion/rerank.
#LEGAL_AI_RETRIEVAL_FETCH_K=20
# Reciprocal-rank-fusion constant.
#LEGAL_AI_RRF_K=60
# Strong semantic match floor (and its cap with a real dense embedder).
#LEGAL_AI_RETRIEVAL_SIMILARITY_FLOOR=0.45
#LEGAL_AI_RETRIEVAL_DENSE_SIMILARITY_FLOOR_CAP=0.45
# Weaker floor used as a fallback pass.
#LEGAL_AI_RETRIEVAL_WEAK_SIMILARITY_FLOOR=0.25
# Minimum shared query terms for lexical candidates.
#LEGAL_AI_RETRIEVAL_MIN_SHARED_TOKENS=2
# Max candidate-set doc-frequency share for a "discriminative" term.
#LEGAL_AI_RETRIEVAL_DISCRIMINATIVE_DF_RATIO=0.2
# Near-duplicate detection threshold.
#LEGAL_AI_DEDUP_JACCARD_THRESHOLD=0.9
# Evidence weaker than this is ignored by ranking.
#LEGAL_AI_MIN_EVIDENCE_SCORE=0.05
# Final ranking blend: relevance + authority + confidence (+ temporal only
# when the plan's temporal_intent is "current"/"historical"; intent "any"
# skips it, preserving legacy behavior).
#LEGAL_AI_RANKING_RELEVANCE_WEIGHT=0.55
#LEGAL_AI_RANKING_AUTHORITY_WEIGHT=0.30
#LEGAL_AI_RANKING_CONFIDENCE_WEIGHT=0.15
#LEGAL_AI_RANKING_TEMPORAL_WEIGHT=0.15
# Temporal relevance scores for unknown status / repealed-before-date /
# unconfirmed applicability.
#LEGAL_AI_TEMPORAL_SCORE_UNKNOWN=0.3
#LEGAL_AI_TEMPORAL_SCORE_REPEALED_BEFORE_DATE=0.1
#LEGAL_AI_TEMPORAL_SCORE_UNCONFIRMED=0.5
# Below this coverage score the coverage auditor requests re-retrieval.
#LEGAL_AI_COVERAGE_RETRY_THRESHOLD=0.6
# Top-N relevance scores averaged into retrieval confidence.
#LEGAL_AI_RETRIEVAL_TOP_MEAN_COUNT=3
# Bounded retry loops (see docs/workflow.md "RETRY STRATEGY").
#LEGAL_AI_MAX_RETRIEVAL_RETRIES=1
#LEGAL_AI_MAX_REFLECTION_ITERATIONS=1

# --- Reranker --------------------------------------------------------------------
# "heuristic" (default, fully offline) | "api" (cross-encoder endpoint:
# BGE/Qwen/Cohere rerank via a Cohere-style /rerank API). "api" without full
# credentials degrades to the heuristic reranker with a warning.
#LEGAL_AI_RERANKER_PROVIDER=heuristic
# e.g. bge-reranker-v2-m3, rerank-multilingual-v3.0
#LEGAL_AI_RERANKER_MODEL=
#LEGAL_AI_RERANKER_API_BASE=
#LEGAL_AI_RERANKER_API_KEY=
#LEGAL_AI_RERANKER_BATCH_SIZE=64
#LEGAL_AI_RERANKER_TIMEOUT_SECONDS=10
# Extra attempts after the first API rerank failure.
#LEGAL_AI_RERANKER_MAX_RETRIES=1
# Heuristic blend weights (similarity vs source confidence).
#LEGAL_AI_RERANK_SIMILARITY_WEIGHT=0.75
#LEGAL_AI_RERANK_CONFIDENCE_WEIGHT=0.25
# Blend one LLM rescore into the rerank (one extra call per retrieval branch).
#LEGAL_AI_RERANK_LLM_ENABLED=true
# Chars of each chunk shown in the LLM rescore prompt.
#LEGAL_AI_RERANK_LLM_EXCERPT_CHARS=300
# Weight of the LLM rescore in the final rerank blend.
#LEGAL_AI_RERANK_LLM_BLEND_WEIGHT=0.5

# --- Planner ---------------------------------------------------------------------
# top_k for auxiliary (gov/regulation/case-law/news) tasks.
#LEGAL_AI_PLANNER_AUX_TOP_K=5
# LLM tool-calling loop budget for the planner agent.
#LEGAL_AI_PLANNER_MAX_TOOL_ITERATIONS=3
# Cap on terminology-expansion keyword tasks per plan.
#LEGAL_AI_PLANNER_MAX_EXPANSION_TASKS=3
# Cap on sub-question keyword tasks added to the plan.
#LEGAL_AI_PLANNER_MAX_SUB_QUESTION_TASKS=6

# --- Answer & confidence ---------------------------------------------------------
# Below this the answer carries a low-confidence warning.
#LEGAL_AI_CONFIDENCE_THRESHOLD=0.55
# Below this, escalate to a human legal expert.
#LEGAL_AI_HUMAN_REVIEW_THRESHOLD=0.40
# Evidence chunks attached to the FinalAnswer.
#LEGAL_AI_ANSWER_MAX_EVIDENCE=10
# Per-excerpt char cap in the evidence block sent to the LLM.
#LEGAL_AI_ANSWER_MAX_EXCERPT_CHARS=4000
# Child-chunk preview length inside a parent excerpt.
#LEGAL_AI_ANSWER_CHILD_PREVIEW_CHARS=200
# Aggregate confidence = citation accuracy + sub-question coverage weights.
#LEGAL_AI_CONFIDENCE_CITATION_WEIGHT=0.4
#LEGAL_AI_CONFIDENCE_COVERAGE_WEIGHT=0.6
# Confidence cap while source conflicts stay unresolved.
#LEGAL_AI_CONFIDENCE_UNRESOLVED_CONFLICT_CAP=0.6
# Confidence cap when reflection flags unanswered parts.
#LEGAL_AI_CONFIDENCE_REFLECTION_GAP_CAP=0.75
# Authority weight assumed for unknown authority levels.
#LEGAL_AI_SOURCE_DEFAULT_AUTHORITY_WEIGHT=0.15
# Temporal confidence while conflicts are unresolved.
#LEGAL_AI_TEMPORAL_CONFLICT_PENALTY=0.5
# Temporal confidence for time-sensitive plans backed by undated sources.
#LEGAL_AI_TEMPORAL_UNDATED_PENALTY=0.6
# Per-chunk char cap in the reasoning agent's evidence digest.
#LEGAL_AI_REASONING_MAX_EXCERPT_CHARS=2000
# Coverage auditor: min length of a discriminative term, and the fraction of a
# question's terms one text must carry to cover it.
#LEGAL_AI_COVERAGE_TERM_MIN_LENGTH=4
#LEGAL_AI_COVERAGE_TERM_MATCH_RATIO=0.5
# Claim verification: sentences shorter than claim_min_chars are connectors,
# not standalone claims; the rest are term-coverage bars for DIRECT / INDIRECT
# support and for declaring a numeric contradiction.
#LEGAL_AI_CLAIM_MIN_CHARS=40
#LEGAL_AI_CLAIM_DIRECT_TERM_COVERAGE=0.7
#LEGAL_AI_CLAIM_INDIRECT_TERM_COVERAGE=0.4
#LEGAL_AI_CLAIM_CONTRADICTION_TERM_COVERAGE=0.6
# Identical-content prefix length compared before declaring a contradiction.
#LEGAL_AI_CONFLICT_PREFIX_CHARS=80

# --- Guardrails & security screening ---------------------------------------------
# User queries longer than this are truncated.
#LEGAL_AI_INPUT_MAX_CHARS=8000
# Scan retrieved chunks for embedded instructions (prompt injection) before
# sending them to the LLM.
#LEGAL_AI_EVIDENCE_INJECTION_SCREENING=true
# Semantic guardrails layer (LLM Guard). Disable only if the scanners cannot
# be installed/loaded; the deterministic regex guards stay active regardless.
#LEGAL_AI_GUARDRAILS_ENABLED=true
#LEGAL_AI_GUARDRAILS_INPUT_SCANNERS=PromptInjection,Jailbreak,Toxicity,Secrets,Anonymize
#LEGAL_AI_GUARDRAILS_OUTPUT_SCANNERS=Toxicity,Bias,MaliciousURLs,Deanonymize
#LEGAL_AI_GUARDRAILS_THRESHOLD=0.75
#LEGAL_AI_GUARDRAILS_PII_LANGUAGE=en
# SSE keepalive frame interval for chat streaming.
#LEGAL_AI_CHAT_HEARTBEAT_SECONDS=10
# Hard cap per chat run (keep below nginx's 300s proxy_read_timeout).
#LEGAL_AI_CHAT_RUN_TIMEOUT_SECONDS=280

# --- Knowledge graph ---------------------------------------------------------------
# Persist the relational legal knowledge graph (backend/knowledge) at ingest
# and let the graph retrieval worker use it; failures never block either path.
#LEGAL_AI_LEGAL_GRAPH_ENABLED=true
# Retrieval score stamped on graph-expansion candidates.
#LEGAL_AI_GRAPH_EXPANSION_SCORE=0.01
# Top-ranked chunks whose graph edges are followed.
#LEGAL_AI_GRAPH_EXPANSION_SOURCES=3
# Hard cap on candidates appended by graph expansion.
#LEGAL_AI_GRAPH_EXPANSION_LIMIT=8

# --- Ingestion & chunking ----------------------------------------------------------
# Parent/child chunk sizes and overlap (characters).
#LEGAL_AI_CHUNK_PARENT_SIZE=2000
#LEGAL_AI_CHUNK_CHILD_SIZE=500
#LEGAL_AI_CHUNK_OVERLAP=100
#LEGAL_AI_CHUNK_MAX_SIZE=2000
# Running-header detection: minimum page count and repetition frequency.
#LEGAL_AI_TEXT_CLEANING_MIN_PAGES_FOR_HEADER=3
#LEGAL_AI_TEXT_CLEANING_HEADER_MIN_FREQUENCY=0.6
# Fetch timeouts for HTML ingestion and freshness checks.
#LEGAL_AI_INGESTION_HTML_TIMEOUT_SECONDS=30
#LEGAL_AI_INGESTION_FRESHNESS_TIMEOUT_SECONDS=20
# Safety cap on parsed PDF pages.
#LEGAL_AI_PDF_PARSER_MAX_PAGES=50

# --- Crawler & freshness -----------------------------------------------------------
# Crawl bounds and politeness.
#LEGAL_AI_CRAWLER_MAX_PAGES=20
#LEGAL_AI_CRAWLER_MAX_DEPTH=2
#LEGAL_AI_CRAWLER_DELAY_SECONDS=1.0
#LEGAL_AI_CRAWLER_TIMEOUT_SECONDS=20
#LEGAL_AI_CRAWLER_USER_AGENT=LegalAI-Burkina-Crawler/1.0 (+offline-first)
# Official-source web retrieval (search worker).
#LEGAL_AI_SEARCH_USER_AGENT=LegalAI-BurkinaFaso/1.0 (official-source retriever)
# Per-request web-source fetch timeout.
#LEGAL_AI_SEARCH_TIMEOUT_SECONDS=8
#LEGAL_AI_SEARCH_MAX_RESULTS_PER_SOURCE=5
# Per-chunk content cap from web sources.
#LEGAL_AI_SEARCH_MAX_CONTENT_CHARS=1200
# Initial retrieval_score for official-source web hits.
#LEGAL_AI_SEARCH_WEB_HIT_SCORE=0.5
# Confidence for sources missing from AUTHORITY_WEIGHTS.
#LEGAL_AI_SEARCH_AUTHORITY_FALLBACK=0.15
# Comma-separated extra domains merged into the crawler allowlist at crawl time.
#LEGAL_AI_CRAWLER_EXTRA_ALLOWED_DOMAINS=

# --- Data & prompt overrides -------------------------------------------------------
# Externalized jurisdictional data files (additive; offline-first). All default
# to None = load the bundled files under data/ (with embedded fallbacks on
# missing/corrupt files, always with a structured warning). Set a filesystem
# path to adapt the platform to another jurisdiction.
# Lexicon JSON for backend/planner/terminology.py (default data/terminology.json).
#LEGAL_AI_TERMINOLOGY_PATH=
# Issue taxonomy JSON for backend/planner/decomposition.py (default data/decomposition.json).
#LEGAL_AI_DECOMPOSITION_PATH=
# Single JSON with search_registry / crawler_allowed_domains /
# freshness_registry / document_titles sections (default data/legal_sources.json).
#LEGAL_AI_LEGAL_SOURCES_PATH=
# Standalone {filename: display title} JSON; overrides the document_titles
# section of the legal-sources file when set.
#LEGAL_AI_DOCUMENT_TITLES_PATH=
# JSON with optional authority_weights / official_domains / legal_domains keys,
# merged onto the backend.core.constants defaults.
#LEGAL_AI_AUTHORITY_CONFIG_PATH=
# Legal rule store for backend/tools/legal_calculations.py (default bundled
# legal_rules.json).
#LEGAL_AI_LEGAL_RULES_PATH=
# Directory of prompt override files for the registry in backend.core.prompts:
# `<NAME>.md` (or `.txt`) where NAME is a registry key (e.g. PLANNER_SYSTEM.md).
# Missing files fall back to the built-in defaults; overrides are cached per
# file and re-read when the file's mtime changes.
#LEGAL_AI_PROMPTS_DIR=

# --- Memory ----------------------------------------------------------------------
# Conversation window (turns) loaded into context.
#LEGAL_AI_CONTEXT_MAX_TURNS=10
# Memories recalled per query.
#LEGAL_AI_MEMORY_RECALL_LIMIT=5
# Age (days) at which a memory gets the full relevance penalty.
#LEGAL_AI_MEMORY_AGE_FULL_PENALTY_DAYS=90
# Days without access before the full penalty applies.
#LEGAL_AI_MEMORY_ACCESS_FULL_PENALTY_DAYS=30
# Hard cap on stored memory records.
#LEGAL_AI_MEMORY_MAX_RECORDS=10000
# Memories below this importance are dropped.
#LEGAL_AI_MEMORY_MIN_IMPORTANCE=0.1
# Summarization window (turns) and summary length (chars).
#LEGAL_AI_MEMORY_SUMMARY_MAX_TURNS=20
#LEGAL_AI_MEMORY_SUMMARY_MAX_LEN=200
# load_conversation_buffer tool: default window size and per-message char cap.
#LEGAL_AI_CONTEXT_BUFFER_LIMIT=20
#LEGAL_AI_CONTEXT_MESSAGE_MAX_CHARS=2000

# --- Temporal (durable workflows) --------------------------------------------------
# [REQUIRED with docker-compose] temporal is the compose service name.
LEGAL_AI_TEMPORAL_ENABLED=true
LEGAL_AI_TEMPORAL_ADDRESS=temporal:7233
LEGAL_AI_TEMPORAL_NAMESPACE=default
#LEGAL_AI_TEMPORAL_TASK_QUEUE=legal-ai
#LEGAL_AI_TEMPORAL_CONNECT_TIMEOUT_SECONDS=5
# Activity execution timeout.
#LEGAL_AI_TEMPORAL_ACTIVITY_TIMEOUT_SECONDS=180
# Ingestion workflow budget.
#LEGAL_AI_TEMPORAL_INGESTION_TIMEOUT_MINUTES=30
# Conversation turns per workflow execution (continue-as-new boundary).
#LEGAL_AI_TEMPORAL_MAX_TURNS_PER_EXECUTION=50
# Browser origin allowed by the Temporal UI CORS. localhost for local access
# only; public URL in production (https://temporal.your-domain.com).
TEMPORAL_UI_CORS_ORIGINS=http://localhost:8080

# --- Celery ----------------------------------------------------------------------
LEGAL_AI_CELERY_BROKER_URL=redis://redis:6379/1
# Per-task hard time limit.
#LEGAL_AI_CELERY_TASK_TIME_LIMIT_SECONDS=600
# Worker process recycling (memory-leak guard).
#LEGAL_AI_CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# --- Observability -------------------------------------------------------------------
#LEGAL_AI_OTEL_ENABLED=false
#LEGAL_AI_OTEL_ENDPOINT=http://localhost:4318

# Langfuse is started with: docker compose --profile observability up -d
# Internal address the BACKEND uses to reach Langfuse (container-to-container
# over the docker network — "langfuse" is the compose service name, this is
# correct as-is, do not replace with localhost).
LEGAL_AI_LANGFUSE_HOST=http://langfuse:3000
LEGAL_AI_LANGFUSE_PUBLIC_KEY=
LEGAL_AI_LANGFUSE_SECRET_KEY=
# Browser-facing URL of the Langfuse UI (used by Langfuse itself for auth
# redirects). localhost works only when you browse from the docker host;
# in production set the public URL, e.g. https://langfuse.your-domain.com.
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
# [REQUIRED with observability profile] Langfuse UI secrets.
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production

# --- Billing (Paddle) --------------------------------------------------------------
# Disabled = platform fully functional, upgrade buttons show "Bientôt disponible".
# Setup guide: docs/billing.md
LEGAL_AI_PADDLE_ENABLED=false
# sandbox | production
LEGAL_AI_PADDLE_ENV=sandbox
LEGAL_AI_PADDLE_API_KEY=
# Notification webhook secret from the Paddle dashboard (webhook URL:
# https://<your-domain>/api/v1/billing/webhook).
LEGAL_AI_PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...) mapped to subscription tiers.
LEGAL_AI_PADDLE_PRICE_PRO=
LEGAL_AI_PADDLE_PRICE_CABINET=
# Redirect URLs after hosted checkout (must point at the frontend).
LEGAL_AI_PADDLE_CHECKOUT_SUCCESS_URL=https://your-domain.com/tarifs?success=1
LEGAL_AI_PADDLE_CHECKOUT_CANCEL_URL=https://your-domain.com/tarifs?canceled=1

# --- Export ------------------------------------------------------------------------
# Heading of exported answer documents (PDF/Word/Markdown).
#LEGAL_AI_EXPORT_PDF_TITLE=Réponse juridique

# --- Sandbox (code-execution tools) --------------------------------------------------
# Optional sandbox runtimes (off = local subprocess sandbox only).
#LEGAL_AI_E2B_ENABLED=false
#LEGAL_AI_PYODIDE_ENABLED=false
# Per-run timeout for the code sandbox and the currency-conversion tool.
#LEGAL_AI_SANDBOX_TIMEOUT_SECONDS=5
#LEGAL_AI_CURRENCY_TOOL_TIMEOUT_SECONDS=5

# --- Evaluation --------------------------------------------------------------------
# Budget for the offline evaluation Celery task.
#LEGAL_AI_CELERY_EVALUATION_TIMEOUT_SECONDS=1800

# --- Frontend (consumed by docker-compose.yml) ---------------------------------------
# NEXT_PUBLIC_API_URL — almost always leave EMPTY. Here's how it works:
#   - EMPTY (recommended): the browser calls the SAME domain that serves the
#     frontend, under /backend-api/... The Next.js server forwards those calls
#     to API_PROXY_TARGET (http://api:8000 — the api container, internal to
#     docker). No CORS involved, works out of the box.
#   - SET (rare): only if the API is served from a DIFFERENT domain than the
#     frontend, e.g. https://api.your-domain.com — the browser then calls that
#     URL directly. Warning: the backend does not enable CORS by default, so
#     this requires putting the two behind one reverse proxy anyway.
# API_PROXY_TARGET — where the Next.js server forwards /backend-api calls.
# http://api:8000 is the compose service name; change only outside compose.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://api:8000

# --- Docker build -------------------------------------------------------------------
# Package indexes used when BUILDING the images. On slow/filtered networks,
# point them to fast mirrors to avoid read timeouts, e.g.:
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
