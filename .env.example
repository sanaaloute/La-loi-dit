# =============================================================================
# Yawoto — Production / Docker Compose environment template
# =============================================================================
# Copy to `.env` and fill in real values before running:
#   cp .env.example .env
#
# This file serves TWO consumers:
#   1. docker-compose.yml — variable interpolation (${POSTGRES_USER}, ...) and
#      `env_file: .env` for the api / celery-worker services. Compose holds NO
#      configuration values of its own: `.env` is the ONLY source of truth.
#      (Single exception: DATABASE_URL is assembled in compose from the
#      POSTGRES_* credentials below, so the password lives in one place.)
#   2. The backend Settings (backend/core/config.py) — every app setting uses
#      the LEGAL_AI_ prefix. Sane defaults exist for everything; only the
#      variables marked [REQUIRED] must be set for production.
#
# IMPORTANT: `.env` is gitignored. Never commit real secrets.
# =============================================================================

# --- Application -------------------------------------------------------------
# [REQUIRED] production enables strict infra mode: no silent fallbacks,
# /ready returns 503 when Milvus/Postgres are down or disabled.
LEGAL_AI_ENV=production
# [REQUIRED] JWT signing key. Generate with: openssl rand -hex 32
LEGAL_AI_SECRET_KEY=change-me-in-production
LEGAL_AI_APP_NAME="Yawoto — Assistant Juridique"
LEGAL_AI_DATA_DIR=/app/data
LEGAL_AI_LOG_LEVEL=INFO

# --- Scalability / high availability ------------------------------------------
# Uvicorn workers for the api service (compose default: 2).
# workers > 1 REQUIRES Redis + Postgres + Milvus (in-memory fallbacks are
# per-process). Strict mode (on in production) reports violations via /ready.
LEGAL_AI_WEB_WORKERS=2
# Override strict mode explicitly (default: on when ENV=production).
#LEGAL_AI_STRICT_INFRA=true

# --- LLM providers -------------------------------------------------------------
# Default/fallback provider used when a request has no tier-specific routing.
# ollama | openrouter | openai | anthropic | gemini | deepseek | qwen | kimi
LEGAL_AI_LLM_PROVIDER=ollama
# Model name WITHOUT the LiteLLM prefix (the app adds it).
LEGAL_AI_LLM_MODEL=gpt-oss:120b
LEGAL_AI_LLM_API_BASE=https://ollama.com
# [REQUIRED with ollama cloud] sent as Authorization: Bearer <key>.
LEGAL_AI_LLM_API_KEY=
LEGAL_AI_LLM_TEMPERATURE=0.1
LEGAL_AI_LLM_MAX_TOKENS=4096
LEGAL_AI_LLM_TIMEOUT_SECONDS=60

# [REQUIRED for Pro/Cabinet tiers] OpenRouter — https://openrouter.ai/keys
# Falls back to LEGAL_AI_LLM_API_KEY when empty.
LEGAL_AI_OPENROUTER_API_KEY=

# TokenFree (OpenAI-compatible API — https://www.tokenfree.com). The app
# targets https://www.tokenfree.com/v1/chat/completions by default (override
# with LEGAL_AI_LLM_API_BASE when tokenfree is the default provider).
LEGAL_AI_TOKENFREE_API_KEY=

# Optional: replace the whole built-in tier catalog (providers, models per
# tier, features, quotas, rate limits) with your own JSON.
# See backend/core/catalog.py for the expected shape.
#LEGAL_AI_TIER_CATALOG_JSON=

# --- Token optimization (defaults are production-ready) ------------------------
#LEGAL_AI_ANSWER_CACHE_ENABLED=true
#LEGAL_AI_ANSWER_CACHE_SEMANTIC_THRESHOLD=0.98
#LEGAL_AI_ANSWER_CACHE_MAX_INDEX=50
#LEGAL_AI_CHEAP_ROUTING_ENABLED=true

# --- Embeddings ----------------------------------------------------------------
# Three supported setups — pick ONE by adjusting MODEL/BASE/KEY below:
#   a) OpenRouter embeddings (default below): model openrouter/<name> — e.g.
#      openrouter/nvidia/nemotron-3-embed-1b:free — base and key are derived
#      from LEGAL_AI_OPENROUTER_API_KEY automatically. NOTE: OpenRouter's
#      /models list does not advertise embedding models, but they are served.
#   b) Ollama Cloud: model ollama/<name>, base https://ollama.com, reuses
#      LEGAL_AI_LLM_API_KEY automatically. Requires an Ollama account whose
#      plan includes embedding models (chat-only accounts get 401 on
#      /api/embed even with a valid key).
#   c) Local Ollama: model ollama/<name>, base http://localhost:11434
#      (or http://host.docker.internal:11434 from containers), no key needed.
# IMPORTANT: the embedding DIMENSION must match the model
# (nvidia/nemotron-3-embed-1b = 2048, nomic-embed-text = 768 — check the model
# card). If you change the model on an existing database, re-ingest your
# documents: stored vectors are not comparable across models.
LEGAL_AI_EMBEDDING_MODEL=openrouter/nvidia/nemotron-3-embed-1b:free
LEGAL_AI_EMBEDDING_DIMENSION=2048
# Optional dedicated key/base — leave empty to reuse the provider keys above.
LEGAL_AI_EMBEDDING_API_KEY=
#LEGAL_AI_EMBEDDING_API_BASE=https://openrouter.ai/api/v1

# --- Infrastructure credentials (consumed by docker-compose.yml) ---------------
# [REQUIRED] Postgres — shared by the app, Temporal and Langfuse.
POSTGRES_USER=legal
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=legal_ai

# [REQUIRED] MinIO (Milvus object storage).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# [REQUIRED] Grafana admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# --- Service wiring (docker network) ------------------------------------------
# [REQUIRED with docker-compose] These were previously hardcoded in compose;
# they now live here. Values use docker service names — change them only for
# deployments outside docker-compose.
LEGAL_AI_MILVUS_ENABLED=true
LEGAL_AI_MILVUS_HOST=milvus
LEGAL_AI_MILVUS_PORT=19530
LEGAL_AI_MILVUS_COLLECTION=legal_chunks
# Optional dev fallback: run WITHOUT the Milvus server by pointing at a local
# Milvus Lite file (takes precedence over HOST/PORT). Local runs on the docker
# host should instead use LEGAL_AI_MILVUS_HOST=localhost (see .env.dev).
#LEGAL_AI_MILVUS_URI=./data/milvus_lite.db
LEGAL_AI_REDIS_ENABLED=true
LEGAL_AI_REDIS_URL=redis://redis:6379/0
LEGAL_AI_CACHE_TTL_SECONDS=3600
# LEGAL_AI_DATABASE_URL is NOT set here: compose assembles it from the
# POSTGRES_* credentials above (single place for the password).
LEGAL_AI_TEMPORAL_ENABLED=true
LEGAL_AI_TEMPORAL_ADDRESS=temporal:7233
LEGAL_AI_TEMPORAL_NAMESPACE=default
LEGAL_AI_CELERY_BROKER_URL=redis://redis:6379/1
LEGAL_AI_EMBEDDING_API_BASE=https://ollama.com
# Internal address the BACKEND uses to reach Langfuse (container-to-container
# over the docker network — "langfuse" is the compose service name, this is
# correct as-is, do not replace with localhost).
LEGAL_AI_LANGFUSE_HOST=http://langfuse:3000
# Browser-facing URL of the Langfuse UI (used by Langfuse itself for auth
# redirects). localhost works only when you browse from the docker host;
# in production set the public URL, e.g. https://langfuse.your-domain.com.
LANGFUSE_NEXTAUTH_URL=http://localhost:3002
# Browser origin allowed by the Temporal UI CORS. Same rule: localhost for
# local access only, public URL in production (https://temporal.your-domain.com).
TEMPORAL_UI_CORS_ORIGINS=http://localhost:8080

# --- Auth / security --------------------------------------------------------------
# JWT lifetime in minutes.
LEGAL_AI_JWT_EXPIRE_MINUTES=60
#LEGAL_AI_JWT_ALGORITHM=HS256
# Anonymous/IP rate limit per minute (tier limits live in the catalog:
# gratuit 30 / pro 120 / cabinet 600).
LEGAL_AI_RATE_LIMIT_PER_MINUTE=30
# Bootstrap accounts, format: user:pass:role,user2:pass2:role2
# (role: admin | legal_expert | user | viewer). Dev-store users get the
# "cabinet" tier — use this to create your first admin in production.
LEGAL_AI_DEV_USERS=

# --- Billing (Paddle) --------------------------------------------------------------
# Disabled = platform fully functional, upgrade buttons show "Bientôt disponible".
# Setup guide: docs/billing.md
LEGAL_AI_PADDLE_ENABLED=false
# sandbox | production
LEGAL_AI_PADDLE_ENV=sandbox
LEGAL_AI_PADDLE_API_KEY=
# Notification webhook secret from the Paddle dashboard (webhook URL:
# https://<your-domain>/api/v1/billing/webhook).
LEGAL_AI_PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...) mapped to subscription tiers.
LEGAL_AI_PADDLE_PRICE_PRO=
LEGAL_AI_PADDLE_PRICE_CABINET=
# Redirect URLs after hosted checkout (must point at the frontend).
LEGAL_AI_PADDLE_CHECKOUT_SUCCESS_URL=https://your-domain.com/tarifs?success=1
LEGAL_AI_PADDLE_CHECKOUT_CANCEL_URL=https://your-domain.com/tarifs?canceled=1

# --- Observability -------------------------------------------------------------------
#LEGAL_AI_OTEL_ENABLED=false
#LEGAL_AI_OTEL_ENDPOINT=http://localhost:4318

# Langfuse is started with: docker compose --profile observability up -d
# LEGAL_AI_LANGFUSE_HOST is set in the service wiring section above.
LEGAL_AI_LANGFUSE_PUBLIC_KEY=
LEGAL_AI_LANGFUSE_SECRET_KEY=

# [REQUIRED with observability profile] Langfuse UI secrets.
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production

# --- Frontend ---------------------------------------------------------------------------
# Consumed by the frontend service build args / environment in compose.
#
# NEXT_PUBLIC_API_URL — almost always leave EMPTY. Here's how it works:
#   - EMPTY (recommended): the browser calls the SAME domain that serves the
#     frontend, under /backend-api/... The Next.js server forwards those calls
#     to API_PROXY_TARGET (http://api:8000 — the api container, internal to
#     docker). No CORS involved, works out of the box.
#   - SET (rare): only if the API is served from a DIFFERENT domain than the
#     frontend, e.g. https://api.your-domain.com — the browser then calls that
#     URL directly. Warning: the backend does not enable CORS by default, so
#     this requires putting the two behind one reverse proxy anyway.
# API_PROXY_TARGET — where the Next.js server forwards /backend-api calls.
# http://api:8000 is the compose service name; change only outside compose.
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://api:8000

# --- Optional: code-execution sandboxes (tools) ---------------------------------------------
#LEGAL_AI_E2B_ENABLED=false
#LEGAL_AI_PYODIDE_ENABLED=false

# --- Docker build -----------------------------------------------------------------------------
# Package indexes used when BUILDING the images. On slow/filtered networks,
# point them to fast mirrors to avoid read timeouts, e.g.:
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org

# --- Tuning (optional; all defaults in backend/core/config.py) -------------------------------
#LEGAL_AI_DEFAULT_TOP_K=8
#LEGAL_AI_RETRIEVAL_FETCH_K=20
#LEGAL_AI_CONTEXT_MAX_TURNS=10
#LEGAL_AI_CONFIDENCE_THRESHOLD=0.55
#LEGAL_AI_HUMAN_REVIEW_THRESHOLD=0.40
# Host port for the postgres service (change if 5432 is taken locally).
POSTGRES_HOST_PORT=5432
