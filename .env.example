# LEGAL_AI_ANSWER_MAX_BULLETS=6
# LEGAL_AI_ANSWER_MAX_EVIDENCE=10
# LEGAL_AI_INPUT_MAX_CHARS=8000
# LEGAL_AI_CHUNK_PARENT_SIZE=1200
# LEGAL_AI_CHUNK_CHILD_SIZE=350
# LEGAL_AI_CHUNK_OVERLAP=60
# LEGAL_AI_CRAWLER_MAX_PAGES=20
# LEGAL_AI_PDF_PARSER_MAX_PAGES=50
