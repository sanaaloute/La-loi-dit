# --- Application ---
# For Docker Compose on Linux/Ubuntu, copy `.env.docker.example` instead.
LEGAL_AI_ENV=development
LEGAL_AI_SECRET_KEY=change-me-in-production
LEGAL_AI_DATA_DIR=./data

# --- LLM (via LiteLLM, OpenAI-compatible multi-provider) ---
# provider: openai | anthropic | gemini | deepseek | qwen | kimi | ollama | mock
LEGAL_AI_LLM_PROVIDER=mock
LEGAL_AI_LLM_MODEL=gpt-4o-mini
LEGAL_AI_LLM_API_KEY=
LEGAL_AI_LLM_API_BASE=
LEGAL_AI_LLM_TEMPERATURE=0.1

# --- Embeddings ---
# Use a separate endpoint from the LLM (e.g. local Ollama for embeddings,
# cloud Ollama for the LLM). Falls back to LLM_API_BASE/LLM_API_KEY when blank.
LEGAL_AI_EMBEDDING_MODEL=text-embedding-3-small
LEGAL_AI_EMBEDDING_API_BASE=
LEGAL_AI_EMBEDDING_API_KEY=

# --- Milvus ---
LEGAL_AI_MILVUS_HOST=localhost
LEGAL_AI_MILVUS_PORT=19530
LEGAL_AI_MILVUS_COLLECTION=legal_chunks

# --- Redis ---
LEGAL_AI_REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL (defaults to local SQLite for development) ---
LEGAL_AI_DATABASE_URL=sqlite+aiosqlite:///./data/legal_ai.db

# --- Temporal ---
LEGAL_AI_TEMPORAL_ADDRESS=localhost:7233
LEGAL_AI_TEMPORAL_NAMESPACE=default
LEGAL_AI_TEMPORAL_ENABLED=false

# --- Celery ---
LEGAL_AI_CELERY_BROKER_URL=redis://localhost:6379/1

# --- Auth / Security ---
LEGAL_AI_JWT_ALGORITHM=HS256
LEGAL_AI_JWT_EXPIRE_MINUTES=60
LEGAL_AI_RATE_LIMIT_PER_MINUTE=30

# --- Observability ---
LEGAL_AI_OTEL_ENDPOINT=http://localhost:4318
LEGAL_AI_OTEL_ENABLED=false
LEGAL_AI_LANGFUSE_PUBLIC_KEY=
LEGAL_AI_LANGFUSE_SECRET_KEY=
LEGAL_AI_LANGFUSE_HOST=http://localhost:3000

# Langfuse UI secrets (used only by the `langfuse` Docker service).
LANGFUSE_NEXTAUTH_SECRET=change-me-in-production
LANGFUSE_SALT=change-me-in-production

# --- Tuning (all optional; defaults are shown in backend/core/config.py) ---
# LEGAL_AI_DEFAULT_TOP_K=8
# LEGAL_AI_RETRIEVAL_FETCH_K=20
# LEGAL_AI_RRF_K=60
