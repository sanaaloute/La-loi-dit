# Force LF line endings for files that must run on Linux, regardless of the
# host's core.autocrlf setting.
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.dockerignore text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
