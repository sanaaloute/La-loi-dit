# Local development environment template.
#
# Copy this file to `.env.dev` before running locally:
#   cp .env.dev.example .env.dev
#
# The app loads `.env.dev` after `.env`, so values here override production
# defaults when both files are present. `.env.dev` is gitignored and should
# never be committed.

# --- Application ---
LEGAL_AI_ENV=development
LEGAL_AI_SECRET_KEY=change-me-in-production
LEGAL_AI_DATA_DIR=./data

# --- LLM ---
# Default to the deterministic offline mock provider so the app runs with
# zero external credentials. Set to ollama/openai/etc. when you want to test
# a real provider locally.
LEGAL_AI_LLM_PROVIDER=mock
LEGAL_AI_LLM_MODEL=gpt-4o-mini
LEGAL_AI_LLM_API_KEY=
LEGAL_AI_LLM_API_BASE=
LEGAL_AI_LLM_TEMPERATURE=0.1

# --- Embeddings ---
LEGAL_AI_EMBEDDING_MODEL=text-embedding-3-small
LEGAL_AI_EMBEDDING_API_BASE=
LEGAL_AI_EMBEDDING_API_KEY=

# --- Stores (localhost/external services) ---
# Milvus/Redis/Temporal are disabled by default in dev; the app falls back to
# in-memory/SQLite equivalents. Flip these to true when you have the services
# running locally.
LEGAL_AI_MILVUS_HOST=localhost
LEGAL_AI_MILVUS_PORT=19530
LEGAL_AI_MILVUS_ENABLED=false
# Or run without any server at all (Milvus Lite, local file):
#LEGAL_AI_MILVUS_URI=./data/milvus_lite.db
LEGAL_AI_REDIS_URL=redis://localhost:6379/0
LEGAL_AI_REDIS_ENABLED=false
LEGAL_AI_DATABASE_URL=sqlite+aiosqlite:///./data/legal_ai.db
LEGAL_AI_TEMPORAL_ADDRESS=localhost:7233
LEGAL_AI_TEMPORAL_ENABLED=false
LEGAL_AI_TEMPORAL_NAMESPACE=default

# --- Celery ---
LEGAL_AI_CELERY_BROKER_URL=redis://localhost:6379/1

# --- Auth / Security ---
LEGAL_AI_JWT_ALGORITHM=HS256
LEGAL_AI_JWT_EXPIRE_MINUTES=60
LEGAL_AI_RATE_LIMIT_PER_MINUTE=30

# --- Observability ---
LEGAL_AI_OTEL_ENDPOINT=http://localhost:4318
LEGAL_AI_OTEL_ENABLED=false
LEGAL_AI_LANGFUSE_PUBLIC_KEY=
LEGAL_AI_LANGFUSE_SECRET_KEY=
LEGAL_AI_LANGFUSE_HOST=http://localhost:3000

# --- Tuning (optional; defaults in backend/core/config.py) ---
#LEGAL_AI_DEFAULT_TOP_K=8
#LEGAL_AI_RETRIEVAL_FETCH_K=20
#LEGAL_AI_CONTEXT_MAX_TURNS=10

# --- Newer knobs worth knowing about in dev (all commented = config defaults) ---
# Offline heuristic reranker is the default; "api" needs a rerank endpoint.
#LEGAL_AI_RERANKER_PROVIDER=heuristic
# Route each agent-graph node's LLM calls to per-role override models (off by
# default — handy to test cheap/strong model splits locally).
#LEGAL_AI_MODEL_ROLE_ROUTING_ENABLED=false
#LEGAL_AI_PLANNER_MODEL=
#LEGAL_AI_SYNTHESIS_MODEL=
# Prompt-injection screening of retrieved chunks (on by default).
#LEGAL_AI_EVIDENCE_INJECTION_SCREENING=true
# Below this coverage score the auditor requests re-retrieval.
#LEGAL_AI_COVERAGE_RETRY_THRESHOLD=0.6
# Relational legal knowledge graph at ingest + graph retrieval worker.
#LEGAL_AI_LEGAL_GRAPH_ENABLED=true
# /ready critical components in strict mode (validated at boot).
#LEGAL_AI_STRICT_CRITICAL_COMPONENTS=milvus,postgres,database_probe,llm,embeddings,user_store
# Extra dev logins: user:password:role,... (role: admin | legal_expert | user | viewer)
#LEGAL_AI_DEV_USERS=
# Point these at alternate files to test another jurisdiction's data/prompts
# without touching data/ (all default to the bundled files / built-ins):
#LEGAL_AI_TERMINOLOGY_PATH=
#LEGAL_AI_DECOMPOSITION_PATH=
#LEGAL_AI_LEGAL_SOURCES_PATH=
#LEGAL_AI_DOCUMENT_TITLES_PATH=
#LEGAL_AI_AUTHORITY_CONFIG_PATH=
#LEGAL_AI_LEGAL_RULES_PATH=
#LEGAL_AI_PROMPTS_DIR=
# Extra domains merged into the crawler allowlist at crawl time.
#LEGAL_AI_CRAWLER_EXTRA_ALLOWED_DOMAINS=
# Optional code-execution sandbox runtimes (off = local subprocess only).
#LEGAL_AI_E2B_ENABLED=false
#LEGAL_AI_PYODIDE_ENABLED=false
